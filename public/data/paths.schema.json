{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "paths.schema.json",
  "title": "Palestine: A Living Map - animated paths",
  "description": "Shape of public/data/paths.json. Mirrors src/data/pathTypes.ts. Extra checks (event exists, dates in order, geometry file exists) live in scripts/validate-data.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "paths"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "paths": { "type": "array", "items": { "$ref": "#/definitions/path" } }
  },
  "definitions": {
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "httpUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "publisher", "accessedDate"],
      "properties": {
        "title": { "$ref": "#/definitions/nonEmpty" },
        "url": { "$ref": "#/definitions/httpUrl" },
        "publisher": { "$ref": "#/definitions/nonEmpty" },
        "accessedDate": { "type": "string", "format": "date" },
        "author": { "$ref": "#/definitions/nonEmpty" },
        "pages": { "$ref": "#/definitions/nonEmpty" },
        "note": { "$ref": "#/definitions/nonEmpty" }
      }
    },
    "waypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "lat", "lng", "date"],
      "properties": {
        "name": { "$ref": "#/definitions/nonEmpty" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "date": { "oneOf": [{ "type": "string", "pattern": "^-?\\d{1,5}(-\\d{2}(-\\d{2})?)?$" }, { "type": "null" }] }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "eventId", "kind", "shape", "waypoints", "lingerYears", "sources", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "eventId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "kind": { "enum": ["campaign", "route", "displacement", "railway"] },
        "shape": { "enum": ["schematic", "traced"] },
        "waypoints": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/waypoint" } },
        "lingerYears": { "type": "integer", "minimum": 0, "maximum": 50 },
        "geometryFile": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.geojson$" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } },
        "status": { "enum": ["verified", "needs-review"] },
        "editorNote": { "$ref": "#/definitions/nonEmpty" }
      }
    }
  }
}

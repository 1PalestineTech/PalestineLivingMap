{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "events.schema.json",
  "title": "Palestine: A Living Map - events file",
  "description": "Shape of public/data/events.json. Mirrors src/data/types.ts. Extra checks (unique ids, date order, era fit, word counts) live in scripts/validate-data.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "events"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "events": { "type": "array", "items": { "$ref": "#/definitions/event" } }
  },
  "definitions": {
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "histDate": {
      "type": "string",
      "pattern": "^-?\\d{1,5}(-\\d{2}(-\\d{2})?)?$",
      "description": "YYYY, YYYY-MM or YYYY-MM-DD; leading '-' for BCE (\"-332\" = 332 BCE); no year 0."
    },
    "httpUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "historicalName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/definitions/nonEmpty" },
        "lang": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$" },
        "period": { "$ref": "#/definitions/nonEmpty" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "nameAr", "nameHe", "lat", "lng", "precision"],
      "properties": {
        "name": { "$ref": "#/definitions/nonEmpty" },
        "nameAr": { "anyOf": [{ "$ref": "#/definitions/nonEmpty" }, { "type": "null" }] },
        "nameHe": { "anyOf": [{ "$ref": "#/definitions/nonEmpty" }, { "type": "null" }] },
        "historicalNames": { "type": "array", "items": { "$ref": "#/definitions/historicalName" } },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "precision": { "enum": ["exact", "area", "approximate"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "publisher", "accessedDate"],
      "properties": {
        "title": { "$ref": "#/definitions/nonEmpty" },
        "url": { "$ref": "#/definitions/httpUrl" },
        "publisher": { "$ref": "#/definitions/nonEmpty" },
        "accessedDate": { "type": "string", "format": "date" },
        "author": { "$ref": "#/definitions/nonEmpty" },
        "pages": { "$ref": "#/definitions/nonEmpty" },
        "note": { "$ref": "#/definitions/nonEmpty" }
      }
    },
    "perspective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewpoint", "claim", "sourceIndex"],
      "properties": {
        "viewpoint": { "$ref": "#/definitions/nonEmpty" },
        "claim": { "$ref": "#/definitions/nonEmpty" },
        "sourceIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt", "credit", "license", "sourceUrl"],
      "properties": {
        "src": { "$ref": "#/definitions/nonEmpty" },
        "alt": { "$ref": "#/definitions/nonEmpty" },
        "credit": { "$ref": "#/definitions/nonEmpty" },
        "license": { "$ref": "#/definitions/nonEmpty" },
        "sourceUrl": { "$ref": "#/definitions/httpUrl" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "dateStart", "dateEnd", "datePrecision", "location",
        "category", "era", "summary", "sources", "status", "tags"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "$ref": "#/definitions/nonEmpty" },
        "dateStart": { "$ref": "#/definitions/histDate" },
        "dateEnd": { "anyOf": [{ "$ref": "#/definitions/histDate" }, { "type": "null" }] },
        "datePrecision": { "enum": ["day", "month", "year", "decade", "century"] },
        "circa": { "type": "boolean" },
        "ongoing": { "type": "boolean" },
        "location": { "$ref": "#/definitions/location" },
        "category": {
          "enum": [
            "political", "conflict", "cultural", "demographic",
            "religious-sites", "displacement", "economy-daily-life", "land-settlement"
          ]
        },
        "era": {
          "enum": [
            "ancient", "classical", "early-islamic", "crusader", "ayyubid-mamluk",
            "ottoman", "british-mandate", "1948-1967", "1967-1993", "1993-present"
          ]
        },
        "summary": { "$ref": "#/definitions/nonEmpty" },
        "details": { "$ref": "#/definitions/nonEmpty" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } },
        "perspectives": { "type": "array", "items": { "$ref": "#/definitions/perspective" } },
        "images": { "type": "array", "items": { "$ref": "#/definitions/image" } },
        "status": { "enum": ["verified", "needs-review"] },
        "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
        "editorNote": { "$ref": "#/definitions/nonEmpty" }
      }
    }
  }
}

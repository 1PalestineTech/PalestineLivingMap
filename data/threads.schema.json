{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "threads.schema.json",
  "title": "Palestine: A Living Map - threads",
  "description": "Shape of public/data/threads.json. Mirrors src/data/threadTypes.ts. Extra checks (ids exist, at least 3 events, intro of at most 60 words) live in scripts/validate-data.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "threads"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "threads": { "type": "array", "items": { "$ref": "#/definitions/thread" } }
  },
  "definitions": {
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "intro", "eventIds", "pathIds", "placeIds", "status"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "kind": { "enum": ["person", "place", "theme"] },
        "title": { "$ref": "#/definitions/nonEmpty" },
        "titleAr": { "$ref": "#/definitions/nonEmpty" },
        "intro": { "$ref": "#/definitions/nonEmpty" },
        "eventIds": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
        "pathIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
        "placeIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
        "status": { "enum": ["verified", "needs-review"] }
      }
    }
  }
}
